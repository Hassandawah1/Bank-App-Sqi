<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register · Bootstrap only</title>
    <!-- Bootstrap 5 (no icons, no extra CSS) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap bundle JS (optional for toggles etc) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="bg-white d-flex align-items-center min-vh-100" style="font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                
                <!-- card: black border, white background, no shadow, minimalist -->
                <div class="card border border-dark rounded-3 bg-white" style="border-width:1px !important; box-shadow: none !important;">
                    <div class="card-body p-4 p-sm-5">
                        <p class="text-success"><%= message %></p>

                        <h2 class="fw-normal text-dark border-bottom border-dark pb-2 mb-4" style="letter-spacing: -0.02em; font-size: 2rem;">
                            Register
                        </h2>

                        <form action="/register" method="post" novalidate>

                            <!-- row: firstname + lastname -->
                            <div class="row g-3">
                                <div class="col-12 col-sm-6">
                                    <label for="firstName" class="form-label text-dark fw-normal">First name</label>
                                    <input type="text" class="form-control bg-white text-dark border border-dark rounded-1" 
                                           id="firstName" name="firstname" placeholder="e.g. Alex" required
                                           style="box-shadow: none !important; border-width:1px;">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label for="lastName" class="form-label text-dark fw-normal">Last name</label>
                                    <input type="text" class="form-control bg-white text-dark border border-dark rounded-1" 
                                           id="lastName" name="lastname" placeholder="e.g. Smith" required
                                           style="box-shadow: none !important; border-width:1px;">
                                </div>
                            </div>

                            <!-- email -->
                            <div class="mt-3">
                                <label for="email" class="form-label text-dark fw-normal">Email address</label>
                                <input type="email" class="form-control bg-white text-dark border border-dark rounded-1" 
                                       id="email" name="email" placeholder="name@example.com" required
                                       style="box-shadow: none !important; border-width:1px;">
                            </div>

                            <!-- password -->
                            <div class="mt-3">
                                <label for="password" class="form-label text-dark fw-normal">Password</label>
                                <input type="password" class="form-control bg-white text-dark border border-dark rounded-1" 
                                       id="password" name="password" placeholder="••••••••" required
                                       style="box-shadow: none !important; border-width:1px;">
                            </div>

                            <!-- course as input field (text input, not dropdown) -->
                            <div class="mt-3">
                                <label for="courseInput" class="form-label text-dark fw-normal">Course</label>
                                <input type="text" class="form-control bg-white text-dark border border-dark rounded-1" 
                                       id="courseInput" name="course" placeholder="e.g. Web Development" required
                                       style="box-shadow: none !important; border-width:1px;">
                            </div>

                            <!-- submit button: black bg, white text, hover inverse (bootstrap override) -->
                            <div class="mt-4">
                                <button type="submit" class="btn w-100 rounded-1 text-white bg-dark border border-dark" 
                                        style="padding: 0.6rem 1.2rem; font-weight: 400; letter-spacing: 0.03em; transition: 0.15s ease; box-shadow: none !important;"
                                        onmouseover="this.style.backgroundColor='#ffffff'; this.style.color='#000000';" 
                                        onmouseout="this.style.backgroundColor='#000000'; this.style.color='#ffffff';">
                                    Create account
                                </button>
                            </div>

                            <!-- minimal line + optional text (only bootstrap classes) -->
                            <hr class="border-dark mt-4 mb-2" style="opacity: 0.3;">
                            <p class="text-center text-dark opacity-50 small m-0">all fields required</p>
                            <a href="/allStudents" class="btn btn-dark">All Students Page</a>

                        </form>

                    </div> <!-- card-body -->
                </div> <!-- card -->

            </div> <!-- col -->
        </div> <!-- row -->
    </div> <!-- container -->

    <!-- (no extra CSS, only bootstrap + inline style for button hover and basic border/shadow removal) -->
</body>
</html>